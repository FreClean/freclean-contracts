# Copy to .env. Never commit the real .env file.

# The deployer/recorder key is not the FreClean treasury key (see
# freclean-payment/SECURITY.md). This key never touches funds, but still
# must be kept secret: whoever holds it can write agreement records.
DEPLOYER_PRIVATE_KEY=

CELO_ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
CELO_MAINNET_RPC_URL=https://forno.celo.org
